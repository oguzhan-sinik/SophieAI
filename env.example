export FREYA_API_KEY=fak_your_key_here                 # from your Freya workspace, under API keys
export FREYA_API_URL=https://staging-app.freyavoice.ai
export FREYA_BANK_TEAM_KEY=pick-any-secret-of-16-or-more-characters   # you make this up. Use the same one every time.

# Builder LLM: Qwen 3.8 on Modal (OpenAI-compatible endpoint with Modal proxy auth)
export MODAL_BASE_URL=https://your-workspace--your-app-serve.modal.run/v1
export MODAL_KEY=wk-your_key_here                  # sent as the Modal-Key header
export MODAL_SECRET=ws-your_secret_here            # sent as the Modal-Secret header
# Select Modal with BUILDER_MODEL=modal/Qwen/Qwen3.8-2.4T-A95B

# Three model tiers used by the builder and synthetic tests. Change any tier here.
# BUILDER_MODEL remains the fallback for hard roles if MODEL_TIER_HARD is unset.
export OPENROUTER_API_KEY=
export BUILDER_MODEL=openrouter/openai/gpt-6.1-sol
export MODEL_TIER_HARD=openrouter/openai/gpt-6.1-sol
export MODEL_TIER_MEDIUM=openrouter/openai/gpt-6-luna-pro
export MODEL_TIER_EASY=openrouter/deepseek/deepseek-v4.1-flash
# Optional per-role override: export ROLE_MODELS=synthetic_customer=openrouter/openai/gpt-6-luna-pro

# QwenCloud remains available for any tier by setting its model ID there.
export DASHSCOPE_API_KEY=
export QWENCLOUD_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
# Thinking is enabled with QwenCloud's default reasoning budget; responses stream.

# Optional Doubleword testing; existing Modal settings stay available.
export DOUBLEWORD_API_KEY=
export DOUBLEWORD_BASE_URL=https://api.doubleword.ai/v1
# Select per run: BUILDER_MODEL=doubleword/zai-org/GLM-5.3-Flash python3 -m generalisation_agent generate
