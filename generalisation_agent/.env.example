# Master-off adds no synthetic generation, tests, or feedback to the existing builder.
GENERALISATION_ENABLED=false
GENERALISATION_BRIEFS_ENABLED=true
GENERALISATION_USERS_ENABLED=true
# All local model roles reuse BUILDER_MODEL from the existing builder configuration.
# QwenCloud is selected in env.sh. Add DASHSCOPE_API_KEY there.
# BUILDER_MODEL=qwencloud/qwen3.8-max-0902
# QWENCLOUD_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
# Optional testing override; leave commented to keep the existing model selection.
# BUILDER_MODEL=doubleword/zai-org/GLM-5.3-Flash
# DOUBLEWORD_API_KEY=  # Alternatively, set it in the kit-root env.sh.
# DOUBLEWORD_BASE_URL=https://api.doubleword.ai/v1
