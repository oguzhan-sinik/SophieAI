# Existing process settings win, then agent/.env, then kit-root .env, then kit-root env.sh.
FREYA_API_KEY=
FREYA_API_URL=https://staging-app.freyavoice.ai
FREYA_BANK_TEAM_KEY=
# Secrets normally live in the kit-root env.sh (loaded automatically). Models go through Google ADK + LiteLLM.
# Builder LLM: Qwen 3.8 on Modal (OpenAI-compatible), authenticated with Modal proxy-auth headers.
MODAL_BASE_URL=
# wk-... sent as the Modal-Key header
MODAL_KEY=
# ws-... sent as the Modal-Secret header
MODAL_SECRET=
# Only if the server itself requires a bearer key
MODAL_API_KEY=
MODAL_ENABLE_THINKING=false
MODAL_JSON_SCHEMA=true
# modal/<served model name>; must match /v1/models on your Modal server
BUILDER_MODEL=modal/Qwen/Qwen3.8-2.4T-A95B
MAX_WALL_SECONDS=1800
MIN_EXPORT_RESERVE_SECONDS=180
EVAL_ENABLE_OFFICIAL_PUBLIC=true
EVAL_REPETITIONS=1
# Root plus one per improvement round.
EVAL_MAX_SIMULATIONS=4
FREYA_MAX_CONCURRENT_SIMULATIONS=1
FREYA_REQUEST_TIMEOUT_SECONDS=90
LLM_CALL_TIMEOUT_SECONDS=480
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=freya-builder-optimizer
ARTIFACTS_DIR=artifacts
