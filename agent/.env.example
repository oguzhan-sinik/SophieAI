# Existing process settings win, then agent/.env, then kit-root .env.
FREYA_API_KEY=
FREYA_API_URL=https://staging-app.freyavoice.ai
FREYA_BANK_TEAM_KEY=
# Existing NVIDIA provider is supported through Google ADK + LiteLLM.
NVIDIA_API_KEY=
GOOGLE_API_KEY=
BUILDER_MODEL=nvidia_nim/z-ai/glm-5.3
MUTATOR_MODEL=
REFEREE_MODEL=
BENCHMARK_MODE=scoring_with_diagnostics
# Only scoring_only or scoring_with_diagnostics is accepted.
MAX_WALL_SECONDS=1800
MIN_EXPORT_RESERVE_SECONDS=180
MAX_CANDIDATES=10
MAX_TREE_DEPTH=3
BEAM_WIDTH=2
GROUP_SIZE=3
SEARCH_SEED=42
EVAL_ENABLE_OFFICIAL_PUBLIC=true
EVAL_REPETITIONS=1
EVAL_FINAL_REPETITIONS=3
EVAL_MAX_SIMULATIONS=2
FREYA_MAX_CONCURRENT_SIMULATIONS=1
FREYA_REQUEST_TIMEOUT_SECONDS=90
LLM_CALL_TIMEOUT_SECONDS=300
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=freya-builder-optimizer
ARTIFACTS_DIR=artifacts
