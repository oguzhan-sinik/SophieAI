{
  "openapi": "3.0.3",
  "info": {
    "title": "Freya Bank collections tools",
    "version": "0.3-draft",
    "description": "Synthetic changed-schema fixture. Never send it to the real public bank service."
  },
  "servers": [
    {
      "url": "https://cedar-synthetic.invalid/v2"
    }
  ],
  "components": {},
  "paths": {
    "/verify_identity": {
      "post": {
        "summary": "Check one security answer. Two wrong answers in total end the check.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string",
                    "enum": [
                      "registration_code",
                      "postal_district"
                    ]
                  },
                  "answer": {
                    "type": "string",
                    "description": "The security answer exactly as spoken; normalize spacing only."
                  }
                },
                "required": [
                  "customer_id",
                  "field",
                  "answer"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "verified": {
                      "type": "boolean"
                    },
                    "wrong_answers_left": {
                      "type": "integer"
                    },
                    "all_verified": {
                      "type": "boolean"
                    },
                    "hint": {
                      "type": "string",
                      "enum": [
                        "day_month_swapped"
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    },
    "/get_account": {
      "post": {
        "summary": "The late products. Refused until both questions are passed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "customer_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "credit_card",
                              "personal_loan",
                              "car_loan"
                            ]
                          },
                          "card_last4": {
                            "type": "string",
                            "description": "credit cards only"
                          },
                          "past_due": {
                            "type": "number"
                          },
                          "days_late": {
                            "type": "integer"
                          },
                          "required_amount": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    },
    "/create_promise": {
      "post": {
        "summary": "Record a payment promise. One per product.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "product_id": {
                    "type": "string"
                  },
                  "sum_due": {
                    "type": "number"
                  },
                  "due_on": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "customer_id",
                  "product_id",
                  "sum_due",
                  "due_on"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "promise_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    },
    "/close_call": {
      "post": {
        "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "arranged",
                      "declined",
                      "unverified",
                      "system_failure"
                    ]
                  }
                },
                "required": [
                  "customer_id",
                  "outcome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    }
  }
}
